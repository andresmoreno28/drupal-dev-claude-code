{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/drupal-lint.sh\"",
            "timeout": 30,
            "statusMessage": "drupal-dev: linting the edited file"
          }
        ]
      }
    ]
  }
}
